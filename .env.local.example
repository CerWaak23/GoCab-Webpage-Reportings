# ============================================================
# GoCab Webapp — Variables de Entorno
# Copia este archivo a .env.local para desarrollo local.
# En Vercel, agrega estas variables en Settings → Environment Variables.
# ============================================================

# ----- Acceso al portal -----
# Contraseña única compartida por todo el equipo. Se pide junto con el correo
# @gocab.io en la pantalla de login. Para rotarla basta cambiar este valor
# (y el de Vercel): todas las sesiones abiertas siguen válidas hasta expirar,
# así que si necesitas cortarlas de inmediato, cambia también NEXTAUTH_SECRET.
# En .env.local usa comillas — el valor empieza con "#" y sin ellas el parser
# lo lee como comentario. En el panel de Vercel va sin comillas.
PORTAL_PASSWORD="tu-contraseña-del-portal"

# ----- NextAuth -----
# Clave secreta para firmar las sesiones. Genera una en:
# https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=cambia-esto-por-un-secreto-largo

# URL de tu app. En producción: tu dominio de Vercel.
# En local: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ----- Google OAuth -----
# Crea credenciales en: https://console.cloud.google.com
# Tipo: "ID de cliente OAuth 2.0" → Aplicación web
# Authorized redirect URIs:
#   - http://localhost:3000/api/auth/callback/google  (desarrollo)
#   - https://TU-DOMINIO.vercel.app/api/auth/callback/google  (producción)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# ----- Snapshots de peajes -----
# Carpeta de Drive donde el cron deja los JSON precalculados
# (gocab-tolls-index.json y gocab-tolls-plates.json). Debe estar compartida
# como Editor con la service account de GOOGLE_CLIENT_EMAIL.
# Si se deja vacía, /api/tolls vuelve a calcular en vivo en cada petición.
TOLLS_SNAPSHOT_FOLDER_ID=

# Secreto que Vercel manda en el header Authorization al ejecutar el cron.
# Sin esta variable el cron recibe 401 y nunca actualiza los snapshots.
CRON_SECRET=genera-un-secreto-largo

# ----- IDs de reportes en Google Drive -----
# Google Drive file ID del reporte de Bills (export-2580-bills.xlsx)
BILLS_FILE_ID=15kFa6-8xuOzvJw9rCSprh52L7E

# ----- Cuenta de servicio de Google (Sheets y Drive) -----
# Las usan todas las rutas que leen planillas o carpetas de Drive.
# En Vercel, la clave privada va con los saltos de línea como \n.
GOOGLE_CLIENT_EMAIL=gobills@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ----- Supabase (Historial de vehículos) -----
# Proyecto en la región São Paulo. Settings → API Keys.
# La clave SECRETA (sb_secret_...) solo va en el servidor: nunca con prefijo
# NEXT_PUBLIC_ ni en el navegador. La publicable (sb_publishable_...) solo
# sirve para iniciar sesión con Google; sin políticas RLS no lee datos.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
